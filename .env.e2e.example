# Credentials for two pre-confirmed test accounts on the Supabase project
# the app's .env points at. See e2e/README.md for setup instructions.
#
# Load these into your shell before running `npm run test:e2e`, e.g.:
#   export $(cat .env.e2e | xargs)   (bash)
# or a tool like `dotenv-cli` / your shell's env-file support.

E2E_USER1_EMAIL=
E2E_USER1_PASSWORD=

E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=
